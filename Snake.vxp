/*
 * Classic Snake for MediaTek MRE (builds to .vxp)
 * Nokia-style: green LCD palette, wrap-around walls, speeds up as you eat.
 *
 * STATUS: written from memory of the MRE 2.0/3.0 API. NOT compiled, NOT tested.
 * Some function signatures or header names may differ in your SDK version.
 * Compile errors are expected to be small (headers, vm_graphic_fill_rect args).
 *
 * BUILD: create a new MRE project in the SDK (Visual Studio plugin), add this
 * file, build for ARM, then package the output into a .vxp with the SDK tool.
 *
 * CONTROLS: arrows or keys 2/4/6/8 steer. OK / key 5 restarts after game over.
 *           Right softkey quits.
 */

#include "vmsys.h"
#include "vmio.h"
#include "vmgraph.h"
#include "vmtimer.h"
#include "vmchset.h"
#include "vmstdlib.h"

#define MAX_CELLS  1600
#define CELL       8
#define HUD_H      16
#define START_LEN  4
#define START_MS   200
#define MIN_MS     70

/* Nokia 3310 style LCD colours, RGB565 */
#define RGB565(r, g, b) ((VMUINT16)((((r) & 0xF8) << 8) | (((g) & 0xFC) << 3) | ((b) >> 3)))
#define COL_BG   RGB565(199, 240, 216)
#define COL_FG   RGB565(67, 82, 61)

enum { DIR_UP, DIR_RIGHT, DIR_DOWN, DIR_LEFT };

static VMINT   layer_hdl[1];
static VMINT   timer_id = -1;
static VMINT   scr_w, scr_h, grid_w, grid_h;
static VMUINT8 bx[MAX_CELLS], by[MAX_CELLS];   /* ring buffer of segments */
static VMINT   head, len, dir, next_dir;
static VMINT   fx, fy, score, over, tick_ms;
static VMUINT32 rng = 12345;

static void handle_sysevt(VMINT message, VMINT param);
static VMINT handle_keyevt(VMINT event, VMINT keycode);
static void game_tick(VMINT tid);

static VMINT rnd(VMINT n)
{
    rng = rng * 1103515245u + 12345u;
    return (VMINT)((rng >> 16) % (VMUINT32)n);
}

static VMINT seg_index(VMINT k)   /* k = 0 is the tail, k = len-1 is the head */
{
    return (head - len + 1 + k + MAX_CELLS * 2) % MAX_CELLS;
}

static VMINT on_snake(VMINT x, VMINT y, VMINT skip_tail)
{
    VMINT k, i;
    for (k = skip_tail ? 1 : 0; k < len; k++) {
        i = seg_index(k);
        if (bx[i] == x && by[i] == y) return 1;
    }
    return 0;
}

static void place_food(void)
{
    VMINT tries = 0;
    do {
        fx = rnd(grid_w);
        fy = rnd(grid_h);
        tries++;
    } while (on_snake(fx, fy, 0) && tries < 500);
}

static void set_timer(void)
{
    if (timer_id >= 0) vm_delete_timer(timer_id);
    timer_id = vm_create_timer(tick_ms, game_tick);
}

static void new_game(void)
{
    VMINT i;
    len = START_LEN;
    head = len - 1;
    for (i = 0; i < len; i++) {
        bx[i] = (VMUINT8)(grid_w / 2 - (len - 1) + i);
        by[i] = (VMUINT8)(grid_h / 2);
    }
    dir = next_dir = DIR_RIGHT;
    score = 0;
    over = 0;
    tick_ms = START_MS;
    place_food();
    set_timer();
}

static void cell_rect(VMUINT8 *buf, VMINT gx, VMINT gy, VMUINT16 col)
{
    /* 1px gap around each cell gives the chunky LCD-pixel look */
    vm_graphic_fill_rect(buf, gx * CELL + 1, HUD_H + gy * CELL + 1,
                         CELL - 2, CELL - 2, col, col);
}

static void draw_text(VMUINT8 *buf, VMINT x, VMINT y, const char *s)
{
    VMWCHAR ws[32];
    vm_ascii_to_ucs2(ws, sizeof(ws), (VMSTR)s);
    vm_graphic_textout(buf, x, y, ws, (VMINT)vm_wstrlen(ws), COL_FG);
}

static void draw_all(void)
{
    VMUINT8 *buf;
    char line[32];
    VMINT k, i;

    if (layer_hdl[0] < 0) return;
    buf = vm_graphic_get_layer_buffer(layer_hdl[0]);
    if (!buf) return;

    vm_graphic_fill_rect(buf, 0, 0, scr_w, scr_h, COL_BG, COL_BG);

    sprintf(line, "SCORE %d", score);
    draw_text(buf, 2, 1, line);
    vm_graphic_fill_rect(buf, 0, HUD_H - 2, scr_w, 1, COL_FG, COL_FG);

    for (k = 0; k < len; k++) {
        i = seg_index(k);
        cell_rect(buf, bx[i], by[i], COL_FG);
    }
    cell_rect(buf, fx, fy, COL_FG);

    if (over) {
        draw_text(buf, scr_w / 2 - 36, scr_h / 2 - 8, "GAME OVER");
        draw_text(buf, scr_w / 2 - 44, scr_h / 2 + 10, "OK = again");
    }
    vm_graphic_flush_layer(layer_hdl, 1);
}

static void game_tick(VMINT tid)
{
    VMINT nx, ny, eat, i;
    static const VMINT dx[4] = { 0, 1, 0, -1 };
    static const VMINT dy[4] = { -1, 0, 1, 0 };

    if (over) return;

    dir = next_dir;
    i = head;
    nx = (bx[i] + dx[dir] + grid_w) % grid_w;   /* wrap-around walls */
    ny = (by[i] + dy[dir] + grid_h) % grid_h;
    eat = (nx == fx && ny == fy);

    /* the tail moves away this step unless we grow, so skip it in the check */
    if (on_snake(nx, ny, eat ? 0 : 1)) {
        over = 1;
        draw_all();
        return;
    }

    if (eat) {
        if (len < MAX_CELLS - 1) len++;
    }
    head = (head + 1) % MAX_CELLS;
    bx[head] = (VMUINT8)nx;
    by[head] = (VMUINT8)ny;

    if (eat) {
        score++;
        place_food();
        if (tick_ms > MIN_MS) {
            tick_ms -= 6;
            if (tick_ms < MIN_MS) tick_ms = MIN_MS;
            set_timer();
        }
    }
    draw_all();
}

static void turn(VMINT d)
{
    /* no 180 degree turns */
    if ((d + 2) % 4 == dir) return;
    next_dir = d;
}

static VMINT handle_keyevt(VMINT event, VMINT keycode)
{
    if (event != VM_KEY_EVENT_DOWN) return 0;

    switch (keycode) {
    case VM_KEY_UP:    case VM_KEY_NUM2: turn(DIR_UP);    break;
    case VM_KEY_RIGHT: case VM_KEY_NUM6: turn(DIR_RIGHT); break;
    case VM_KEY_DOWN:  case VM_KEY_NUM8: turn(DIR_DOWN);  break;
    case VM_KEY_LEFT:  case VM_KEY_NUM4: turn(DIR_LEFT);  break;
    case VM_KEY_OK:    case VM_KEY_NUM5:
        if (over) { new_game(); draw_all(); }
        break;
    case VM_KEY_RIGHT_SOFTKEY:
        vm_exit_app();
        break;
    default: break;
    }
    return 0;
}

static void handle_sysevt(VMINT message, VMINT param)
{
    switch (message) {
    case VM_MSG_CREATE:
    case VM_MSG_ACTIVE:
        scr_w = vm_graphic_get_screen_width();
        scr_h = vm_graphic_get_screen_height();
        grid_w = scr_w / CELL;
        grid_h = (scr_h - HUD_H) / CELL;
        if (grid_w * grid_h > MAX_CELLS) {   /* very large screens */
            grid_w = 40;
            grid_h = 40;
        }
        layer_hdl[0] = vm_graphic_create_layer(0, 0, scr_w, scr_h, -1);
        vm_graphic_set_clip(0, 0, scr_w, scr_h);
        rng ^= (VMUINT32)vm_get_tick_count();
        new_game();
        draw_all();
        break;

    case VM_MSG_PAINT:
        draw_all();
        break;

    case VM_MSG_INACTIVE:
    case VM_MSG_QUIT:
        if (timer_id >= 0) { vm_delete_timer(timer_id); timer_id = -1; }
        if (layer_hdl[0] >= 0) {
            vm_graphic_delete_layer(layer_hdl[0]);
            layer_hdl[0] = -1;
        }
        break;
    default: break;
    }
}

void vm_main(void)
{
    layer_hdl[0] = -1;
    vm_reg_sysevt_callback(handle_sysevt);
    vm_reg_keyboard_callback(handle_keyevt);
}
